{
  "name": "@stelmakhdigital/observational-memory",
  "version": "0.4.0",
  "description": "Agent-agnostic observational memory core (observers/compaction/consolidator) with a pi-coding-agent adapter",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "observational-memory", "llm", "agent", "memory", "pi-coding-agent", "context-compaction"],
  "pi": {
    "extensions": ["./src/adapters/pi/index.ts"]
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./adapters/pi": {
      "types": "./dist/adapters/pi/index.d.ts",
      "default": "./dist/adapters/pi/index.js"
    },
    "./adapters/mcp": {
      "types": "./dist/adapters/mcp/server.d.ts",
      "default": "./dist/adapters/mcp/server.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:scripts": "tsc -p tsconfig.build.scripts.json",
    "prepare": "npm run build",
    "demo": "npm run build:scripts && node dist-scripts/examples/embedded-demo.js",
    "eval": "npm run build:scripts && node dist-scripts/eval/run.js",
    "mcp": "npm run build && node dist/adapters/mcp/server.js"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typebox": "^1.3.27",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
