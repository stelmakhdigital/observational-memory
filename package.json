{
  "name": "@arkalaust/observational-memory",
  "version": "0.1.0-dev",
  "description": "Agent-agnostic observational memory core (observers/compaction/consolidator) with a pi-coding-agent adapter",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "observational-memory", "llm", "agent", "memory", "pi-coding-agent", "context-compaction"],
  "pi": {
    "extensions": ["./src/adapters/pi/index.ts"]
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./core": "./src/core/index.ts",
    "./adapters/pi": "./src/adapters/pi/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typebox": "^1.3.27",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
